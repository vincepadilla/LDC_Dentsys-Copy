RewriteEngine On

# Security
Options -Indexes
AddDefaultCharset UTF-8

# ------------------------------------------
# 1) Redirect folder/php URLs to clean URLs (GET only)
# ------------------------------------------
# /views/page.php  -> /page
# /admin/page.php  -> /page
RewriteCond %{REQUEST_METHOD} GET
RewriteRule ^(?:views|admin)/([a-zA-Z0-9_-]+)\.php$ /$1 [R=301,L,NC]

# /controllers/name.php -> /api/name
RewriteCond %{REQUEST_METHOD} GET
RewriteRule ^controllers/([a-zA-Z0-9_-]+)\.php$ /api/$1 [R=301,L,NC]

# /api/name.php -> /api/name
RewriteCond %{REQUEST_METHOD} GET
RewriteRule ^api/([a-zA-Z0-9_-]+)\.php$ /api/$1 [R=301,L,NC]

# ------------------------------------------
# 2) API clean route
# ------------------------------------------
RewriteRule ^api/([a-zA-Z0-9_-]+)/?$ controllers/$1.php [L,QSA,NC]

# ------------------------------------------
# 3) Root and clean page routes
# ------------------------------------------
RewriteRule ^$ views/index.php [L,QSA]

# Prefer views first
RewriteCond %{DOCUMENT_ROOT}/views/$1.php -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ views/$1.php [L,QSA]

# Then admin pages (e.g., /appointment -> admin/appointment.php)
RewriteCond %{DOCUMENT_ROOT}/admin/$1.php -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ admin/$1.php [L,QSA]

# ------------------------------------------
# 4) Allow existing files/folders (assets, uploads, etc.)
# ------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ------------------------------------------
# 5) Block direct folder access in URL
# ------------------------------------------
RewriteRule ^(?:views|controllers|admin)/ - [R=404,L,NC]